rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isValidUserData() {
      return request.resource.data.keys().hasAll(['name', 'email', 'role']) &&
        request.resource.data.role in ['user', 'admin'];
    }
    
    // Users collection - main user profiles
    match /users/{userId} {
      // Users can read and write their own data
      allow read, write: if isOwner(userId);
      
      // Admins can read all user data
      allow read: if isAdmin();
      
      // Admins can update user approval status and role
      allow update: if isAdmin() && 
        request.resource.data.keys().hasAll(['isApproved', 'adminNotes', 'role']);
      
      // User subcollections
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }
      
      match /estimatedBill/{billId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }
      
      match /energy_usage_logs/{logId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }
    }
    
    // Power rates collection - admin managed
    match /power_rates/{rateId} {
      // Everyone can read power rates
      allow read: if isAuthenticated();
      
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // Support chats collection
    match /support_chats/{chatId} {
      // Users can read and write their own chats
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.adminId);
      
      // Admins can read all chats
      allow read: if isAdmin();
      
      // Only admins can create admin messages
      allow create: if isAdmin() && 
        request.resource.data.senderType == 'admin';
    }
    
    // Tips collection - public read, admin write
    match /tips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read and update their own notifications
      allow read, update: if isOwner(resource.data.userId);
      
      // System can create notifications for users
      allow create: if isAuthenticated();
      
      // Admins can read all notifications
      allow read: if isAdmin();
    }
    
    // Device control collection - user specific IoT config
    match /device_control/{deviceId} {
      // Users can read and write their own device configs
      allow read, write: if isOwner(resource.data.userId);
      
      // Admins can read all device configs
      allow read: if isAdmin();
    }
    
    // Admins collection
    match /admins/{adminId} {
      // Only admins can read admin status
      allow read: if isOwner(adminId) || isAdmin();
      
      // Only existing admins can add new admins
      allow create: if isAdmin();
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
